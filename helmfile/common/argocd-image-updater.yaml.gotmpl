config:
  registries:
  - name: ECR
    api_url: https://{{ .Values.accountID }}.dkr.ecr.{{ .Values.awsRegion }}.amazonaws.com
    prefix: {{ .Values.accountID }}.dkr.ecr.{{ .Values.awsRegion }}.amazonaws.com   # before v0.12 this needed to be set empty, prefix: ""
    default: true  # not supported before v0.12
    ping: true
    insecure: false
    credentials: ext:/scripts/ecr-login.sh  #script name should match here and in authScripts
    credsexpire: 12h

  gitCommitTemplate: |-
    build: automatic update of {{ `{{ .AppName }}` }}

    {{ `{{ range .AppChanges -}}` }}
    {{ `updates image {{ .Image }} tag from '{{ .OldTag }}' to '{{ .NewTag }}'` }}
    {{ `{{ end -}}` }}

authScripts:
  enabled: true
  scripts:
    # https://github.com/argoproj-labs/argocd-image-updater/issues/720
    ecr-login.sh: |   # notice script name matches above
      #!/bin/sh
      HOME=/tmp aws ecr --region $AWS_REGION get-authorization-token --output text --query 'authorizationData[].authorizationToken' | base64 -d

extraEnv:
  - name: AWS_REGION
    value: {{ .Values.awsRegion }}

serviceAccount:
  create: true
  name: "argocd-image-updater"

metrics:
  enabled: true

  serviceMonitor:
    enabled: true
    additionalLabels:
      release: prometheus-operator
