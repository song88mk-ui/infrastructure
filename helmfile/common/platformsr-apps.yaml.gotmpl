# vi: ft=yaml

environment: {{ .Environment.Name }}
namespace: platformsr
project: platform-sr
appPrefix: platform

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: rabbitmq-api
    chart: platform-app
  - name: sportsbook-api
    chart: platform-app
  - name: betting-api
    chart: platform-app
  - name: api
    config: platform-api
    chart: platform-app
  - name: auth-api
    chart: platform-app
  - name: operator-api
    chart: platform-app
  - name: betinfo-service
    chart: platform-app
  - name: cancellation-service
    chart: platform-app
  - name: cashout-service
    chart: platform-app
  - name: cashoutstake-service
    chart: platform-app
  - name: client-api
    chart: platform-app
  - name: client-topmarket-service
    chart: platform-app
  - name: clientplatform-api
    chart: platform-app
  - name: clientsportsbook-api
    chart: platform-app
  - name: job-forexeur
    chart: platform-app
  - name: job-resettlement
    chart: platform-app
  - name: operator-cashout-service
    chart: platform-app
  - name: operator-service
    chart: platform-app
  - name: placement-service
    chart: platform-app
  - name: settlement-service
    chart: platform-app
  - name: websocket-api
    chart: platform-app
