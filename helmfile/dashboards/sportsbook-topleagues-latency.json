      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase({__name__=~\"sportsbook_topleagues_phase_duration(_milliseconds)?_bucket\", phase=\"total\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__range])))",
