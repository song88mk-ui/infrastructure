provider:
  name: aws

policy: sync

serviceAccount:
  name: "external-dns-aws"

aws:
  region: {{ .Values.awsRegion }}
  zoneType: public
  batchChangeSize: 3000

txtOwnerId: route53-ext
txtPrefix: route53-

resources:
  limits:
    memory: 100Mi
  requests:
    cpu: 10m
    memory: 100Mi

serviceAccount:
  name: external-dns-aws-sa

metrics:
  enabled: true
  serviceMonitor:
    enabled: true
    labels:
      release: prometheus-operator

domainFilters:
  - {{ .Environment.Name }}.song88.com
