ingress-nginx:
  enabled: false

monitoringPasscode: test_pass_code

community:
  enabled: true

persistence:
  enabled: true

initSysctl:
  enabled: true

initFs:
  enabled: true

jdbcOverwrite:
  enabled: true
  jdbcUrl: "jdbc:postgresql://sonarqube-postgresql-rw.sonarqube.svc.cluster.local:5432/sonarqube"
  jdbcUsername: sonarqube
  jdbcSecretName: sonarqube-db
  jdbcSecretPasswordKey: password
