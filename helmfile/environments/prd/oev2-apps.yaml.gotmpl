# vi: ft=yaml
---
tagRegex: ".*-prd"

apps:
  - name: adapter-service
    config: adapter-service
    chart: platform-app
  - name: job-keepalive
    chart: platform-app
  - name: sportsbook-service-00
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-00.yaml
  - name: sportsbook-service-01
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-01.yaml
  - name: sportsbook-service-02
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-02.yaml
  - name: sportsbook-service-03
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-03.yaml
  - name: sportsbook-service-04
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-04.yaml
  - name: sportsbook-service-05
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-05.yaml
  - name: sportsbook-service-06
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-06.yaml
  - name: sportsbook-service-07
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-07.yaml
  - name: sportsbook-service-08
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-08.yaml
  - name: sportsbook-service-09
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-09.yaml
  - name: sportsbook-service-10
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-10.yaml
  - name: job-settlement
    chart: platform-app
  - name: job-cleanup
    chart: platform-app
  - name: job-livestream
    chart: platform-app
  - name: job-lookup
    chart: platform-app
  - name: job-boostedoddscap
    chart: platform-app
  - name: translation-service
    chart: platform-app
  - name: translation-job
    chart: platform-app

  # apps for prd only
  - name: uof-client-g00
    config: uof-client
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-g00.yaml

  # websocket services
  - name: oev2-websocket-service
    config: websocket-service
    appImageOverride: oev2-websocket-service
    chart: platform-app
