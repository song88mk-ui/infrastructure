# vi: ft=yaml

---
environments:
  sandbox:
    kubeContext: song88-sandbox-cluster
    values:
    - environments/sandbox/values.yaml
---
repositories:
- name: prometheus
  url: https://prometheus-community.github.io/helm-charts
- name: cluster-autoscaler
  url: https://kubernetes.github.io/autoscaler
- name: aws
  url: https://aws.github.io/eks-charts
- name: metrics-server
  url: https://kubernetes-sigs.github.io/metrics-server
- name: aws-ebs-csi-driver
  url: https://kubernetes-sigs.github.io/aws-ebs-csi-driver
- name: grafana
  url: https://grafana.github.io/helm-charts
- name: argo
  url: https://argoproj.github.io/argo-helm
- name: fluent
  url: https://fluent.github.io/helm-charts
- name: ingress-nginx
  url: https://kubernetes.github.io/ingress-nginx
- name: external-secrets
  url: https://charts.external-secrets.io
- name: external-dns 
  url: https://kubernetes-sigs.github.io/external-dns/
- name: simcube
  url: https://simcubeltd.github.io/simcube-helm-charts/
- name: bitnami
  url: https://charts.bitnami.com/bitnami

helmDefaults:
  verify: false
  wait: true
  waitForJobs: true
  timeout: 600
  recreatePods: false
  force: false
  historyMax: 10
  createNamespace: true

releases:
  - name: prometheus-operator
    namespace: monitoring
    chart: prometheus/kube-prometheus-stack
    version: 78.5.0
    values:
      - common/prometheus-operator.yaml.gotmpl
      - common/prometheus-alert-templates.yaml
      - environments/{{ .Environment.Name }}/prometheus-operator.yaml.gotmpl

  - name: cluster-autoscaler
    namespace: kube-system
    chart: cluster-autoscaler/cluster-autoscaler
    version: 9.52.1
    values:
      - common/cluster-autoscaler.yaml.gotmpl
      - environments/{{ .Environment.Name }}/cluster-autoscaler.yaml

  - name: metrics-server
    namespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.13.0
    values: []

  - name: loki
    namespace: monitoring
    chart: grafana/loki
    version: 6.44.0
    values:
      - common/loki.yaml.gotmpl
      - environments/{{ .Environment.Name }}/loki.yaml.gotmpl

  - name: external-dns-aws
    namespace: kube-system
    chart: external-dns/external-dns
    version: 1.19.0
    values:
      - common/external-dns-aws.yaml.gotmpl
      - environments/{{ .Environment.Name }}/external-dns-aws.yaml.gotmpl

  - name: argocd
    namespace: argocd
    createNamespace: true
    chart: argo/argo-cd
    version: 9.0.4
    values:
      - common/argocd.yaml.gotmpl
      - common/argocd-notifications.yaml
      - environments/{{ .Environment.Name }}/argocd.yaml.gotmpl

  - name: argocd-image-updater
    namespace: argocd
    createNamespace: true
    chart: argo/argocd-image-updater
    version: 0.14.0
    values:
      - common/argocd-image-updater.yaml.gotmpl
      - environments/{{ .Environment.Name }}/argocd-image-updater.yaml

  - name: fluent-bit
    namespace: kube-system
    chart: fluent/fluent-bit
    version: 0.54.0
    values:
      - common/fluent-bit.yaml.gotmpl
      - environments/{{ .Environment.Name }}/fluent-bit.yaml

  - name: ingress-nginx
    namespace: ingress-nginx
    chart: ingress-nginx/ingress-nginx
    version: 4.13.3
    values:
      - common/ingress-nginx.yaml.gotmpl
      - environments/{{ .Environment.Name }}/ingress-nginx.yaml

  - name: external-secrets
    namespace: external-secrets
    chart: external-secrets/external-secrets
    version: 0.20.3
    timeout: 600
    values:
      - common/external-secrets.yaml
      - environments/{{ .Environment.Name }}/external-secrets.yaml

  - name: storage-class
    namespace: kube-system
    chart: charts/storage-class
    version: 1.0.0

  - name: priority-class
    namespace: kube-system
    chart: charts/priority-class
    version: 1.0.0

  # NOTE: Applications that will be moved to ArgoCD once ready
  - name: bg-rabbitmq-api
    namespace: bet-genius-apps
    chart: charts/bet-genius-app
    version: 0.1.0
    values:
      - common/bg-rabbitmq-api.yaml

  - name: bg-receiver-service
    namespace: bet-genius-apps
    chart: charts/bet-genius-app
    version: 0.1.0
    values:
      - common/bg-receiver-service.yaml

  - name: bg-feed-receiver-api
    namespace: bet-genius-apps
    chart: charts/bet-genius-app
    version: 0.1.0
    values:
      - common/bg-feed-receiver-api.yaml

  # NOTE: Temporary mssql instance
  - name: mssql
    namespace: bet-genius-apps
    chart: simcube/mssqlserver-2022
    version: 1.2.3
    values:
      - sapassword: YourStrong@Passw0rd123
      - acceptEula:
          value: "Y"
      - persistence:
          enabled: true
          storageClass: "gp3"
          dataSize: 10Gi
      - resources:
          limits:
            memory: 2Gi
          requests:
            cpu: 10m
            memory: 2Gi

  # NOTE: Temporary mongodb instance. To be evaluated if an AWS can be used.
  - name: mongodb
    namespace: bet-genius-apps
    chart: bitnami/mongodb
    version: 18.1.1
    values:
      - common/mongodb.yaml

  # NOTE: Rabbitmq is installed following: https://www.rabbitmq.com/kubernetes/operator/quickstart-operator
  # TODO: Integrate with helmfile
