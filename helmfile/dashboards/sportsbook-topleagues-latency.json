          "expr": "sum(increase({__name__=~\"sportsbook_topleagues_phase_duration(_milliseconds)?_sum\", phase=\"mongo_fetch\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__range])) / sum(increase({__name__=~\"sportsbook_topleagues_fixtures(_count)?_sum\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__range]))",
