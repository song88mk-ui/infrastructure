
secrets:
  - name: sql-connection-string
    data:
    - key: sql-connection-string
      remoteKey: /{{ .Environment.Name }}/translation-db-updater/db-connection-string
      envVariable: SQL_CONNECTION_STRING
  - name: deepl-api-key
    data:
    - key: deepl-api-key
      remoteKey: /{{ .Environment.Name }}/translation-db-updater/deepl-api-key
      envVariable: DEEPL_API_KEY
  - name: cache-preload-api-key
    data:
    - key: cache-preload-api-key
      remoteKey: /{{ .Environment.Name }}/translation-db-updater/cache-preload-api-key
      envVariable: CACHE_PRELOAD_API_KEY

env:
  # Platform.API's payload-carrying announce (InternalController route "v1/cachepreload",
  # auth: x-api-key must equal Platform.API Custom:InternalAPIKey — the cache-preload-api-key
  # SSM secret above must hold that value). In-cluster URL: the CronJob runs in the same
  # "platform" namespace. The previous bo-api.{env} URL hit Backoffice's legacy purge-only
  # endpoint, which 400s on the {cacheType, translations} payload update.py sends — every
  # announce silently failed, so services only saw new translations after a restart.
  CACHE_PRELOAD_URL: "http://platform-api.platform.svc:3000/v1/cachepreload"
  ENVIRONMENT: {{ .Environment.Name | upper }}
  DEEPL_API_URL: https://api.deepl.com
