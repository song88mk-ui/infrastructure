prometheus:
  # We don't care about redundancy on a non-prod environment.
  podDisruptionBudget:
    enabled: false
    minAvailable: 1

  prometheusSpec:
    replicas: 1
    scrapeInterval: 30s
    secrets:
      - rabbitmq-basic-auth
    additionalScrapeConfigs:
      - job_name: "node-exporter-mongodb"
        scrape_interval: 30s
        scheme: http
        static_configs:
          - targets: ['10.59.100.160:9092']
      - job_name: "mongodb-exporter"
        scrape_interval: 30s
        scheme: http
        static_configs:
          - targets: ['10.59.100.160:9216']
      - job_name: "rabbitmq"
        scrape_interval: 60s
        scheme: https
        basic_auth:
          username_file: /etc/prometheus/secrets/rabbitmq-basic-auth/username
          password_file: /etc/prometheus/secrets/rabbitmq-basic-auth/password
        static_configs:
          - targets: ['b-bfc99daf-fb92-4742-af20-8bcf6bd1f118.mq.ap-east-1.on.aws:16001']

grafana:
  ingress:
    annotations:
      alb.ingress.kubernetes.io/group.name: eks-apps

  grafana.ini:
    auth.google:
      name: Google
      enabled: true
      allow_sign_up: true
      auto_login: false
      client_id: "ref+awsssm://prd/song88/google/client-id?region=ap-east-1"
      client_secret: "ref+awsssm://prd/song88/google/client-secret?region=ap-east-1"
      scopes: openid email profile
      role_attribute_path: contains('["ksideris@song88.com","michel@song88.com","kbrillante@song88.com"]', email) && 'Admin' || 'Editor'
      role_attribute_strict: true
      skip_org_role_sync: true
      allowed_domains: song88.com
      hosted_domain: song88.com

alertmanager:
  # We don't care about redundancy on a non-prod environment.
  podDisruptionBudget:
    enabled: false
    minAvailable: 1
  alertmanagerSpec:
    replicas: 1
