aws_account_id := `aws sts get-caller-identity --query Account --output text`
region         := `echo "$AWS_REGION"`
repo           := "api-sports-caching-proxy"

# Derived values
version  := `node -p "require('./package.json').version"`
registry := aws_account_id + ".dkr.ecr." + region + ".amazonaws.com"
image    := registry + "/" + repo

# Show available commands
default:
    @just --list

# Print the version resolved from package.json
version:
    @echo {{version}}

# Build the image, tagging with the package.json version
build:
    docker build --tag {{image}}:{{version}} .

# Authenticate the local Docker daemon against ECR
login:
    aws ecr get-login-password --region {{region}} \
        | docker login --username AWS --password-stdin {{registry}}

# Build + authenticate + push (both tags)
push: build login
    docker push {{image}}:{{version}}

# Start the local redis server
run-redis:
    docker compose up
