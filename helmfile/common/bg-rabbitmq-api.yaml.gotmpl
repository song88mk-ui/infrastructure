image:
  repository: {{ .Values.accountID }}.dkr.ecr.{{ .Values.awsRegion }}.amazonaws.com/bg-rabbitmq-api
  tag: main-sha-61749b7

nameOverride: "bg-rabbitmq-api"

serviceAccount:
  name: "bg-rabbitmq-api-sa"

env:
  MessageBroker__Host: rabbitmq-main-cluster.bet-genius-apps.svc
  MessageBroker__Username: default_user_UIwteCseCcfw9vLqO4I
  MessageBroker__Password: CirUnta9bqconlkmeP-FXsyDTFX8O1xz
  MessageBroker__VirtualHost: "/"
  MessageBroker__Exchange: "e.central"
  MessageBroker__Queue: ""
  MessageBroker__Consumer: ""
  MessageBroker__RoutingKey: ""

ingress:
  enabled: true
  annotations:
    alb.ingress.kubernetes.io/load-balancer-name: {{ .Environment.Name }}-eks-alb
    alb.ingress.kubernetes.io/group.name: apps
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    alb.ingress.kubernetes.io/ssl-redirect: '443'
    alb.ingress.kubernetes.io/certificate-arn: {{ .Values.wildcardCertificate }}
    alb.ingress.kubernetes.io/ssl-policy: ELBSecurityPolicy-TLS13-1-2-Res-2021-06
    alb.ingress.kubernetes.io/healthcheck-path: /healthz
  hosts:
  - host: bg-rmq-api.{{ .Environment.Name }}.song88.com
    paths:
      - path: /
