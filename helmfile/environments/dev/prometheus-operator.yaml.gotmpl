prometheus:
  # We don't care about redundancy on a non-prod environment.
  podDisruptionBudget:
    enabled: false
    minAvailable: 1

  prometheusSpec:
    replicas: 1

grafana:
  grafana.ini:
    # TODO: Figure out which OAuth backend we'll use
    auth.azuread:
      name: Azure AD
      enabled: true
      allow_sign_up: true
      client_id: "ref+awsssm://dev/song88/grafana/client-id?region=ap-south-1"
      client_secret: "ref+awsssm://dev/song88/grafana/client-secret?region=ap-south-1"
      scopes: openid email profile
      auth_url: https://login.microsoftonline.com/db9c6ce8-acbf-455d-96d7-d9969e976d0d/oauth2/v2.0/authorize
      token_url: https://login.microsoftonline.com/db9c6ce8-acbf-455d-96d7-d9969e976d0d/oauth2/v2.0/token
      role_attribute_strict: false
      allow_assign_grafana_admin: false
      allowed_domains: ""
      allowed_groups: ""

alertmanager:
  # We don't care about redundancy on a non-prod environment.
  podDisruptionBudget:
    enabled: false
    minAvailable: 1
  alertmanagerSpec:
    replicas: 1
