prometheus:
  ingress:
    annotations:
      alb.ingress.kubernetes.io/certificate-arn: arn:aws:acm:ap-east-1:418541840646:certificate/327da8a0-1d86-469a-8bce-5b97df83a6eb

  prometheusSpec:
    scrapeInterval: 30s
    additionalScrapeConfigs: []

    storageSpec:
      volumeClaimTemplate:
       spec:
         resources:
           requests:
             storage: 50Gi

grafana:
  ingress:
    enabled: true
    annotations:
      alb.ingress.kubernetes.io/certificate-arn: arn:aws:acm:ap-east-1:418541840646:certificate/327da8a0-1d86-469a-8bce-5b97df83a6eb

  grafana.ini:
    server:
      root_url: https://grafana.sandbox.int.song88.com
      domain: grafana.sandbox.int.song88.com
      enable_gzip: true
    auth.azuread:
      name: Azure AD
      enabled: true
      allow_sign_up: true
      client_id: "ref+awsssm://sandbox/song88/grafana/client-id?region=ap-east-1"
      client_secret: "ref+awsssm://sandbox/song88/grafana/client-secret?region=ap-east-1"
      scopes: openid email profile
      auth_url: https://login.microsoftonline.com/db9c6ce8-acbf-455d-96d7-d9969e976d0d/oauth2/v2.0/authorize
      token_url: https://login.microsoftonline.com/db9c6ce8-acbf-455d-96d7-d9969e976d0d/oauth2/v2.0/token
      role_attribute_strict: false
      allow_assign_grafana_admin: false
      allowed_domains: ""
      allowed_groups: ""

alertmanager:
  ingress:
    annotations:
      alb.ingress.kubernetes.io/certificate-arn: arn:aws:acm:ap-east-1:418541840646:certificate/327da8a0-1d86-469a-8bce-5b97df83a6eb
