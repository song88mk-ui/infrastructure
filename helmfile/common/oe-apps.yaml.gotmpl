# vi: ft=yaml

environment: {{ .Environment.Name }}
namespace: oe
project: default

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: oe-rabbitmq-api
    chart: platform-app
  - name: oe-adapter-uof
    chart: platform-app
  - name: oe-adapter-service
    chart: platform-app
  # oddsengine sportsbook
  - name: oe-sportsbook-service-00
    config: oe-sportsbook-service
    chart: platform-app
    valueFiles:
      - ../../apps/oe-sportsbook-service/{{ .Environment.Name }}-00.yaml
  - name: oe-sportsbook-service-01
    config: oe-sportsbook-service
    chart: platform-app
    valueFiles:
