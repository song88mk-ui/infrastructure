region: {{ .Values.awsRegion }}

# Will be used by charts without secret support.
secrets:
  - name: cloudflare-api-token
    namespace: kube-system
    data:
    - key: token
      remoteKey: /{{ .Environment.Name }}/song88/cloudflare/dns-zone-token
  - name: rabbitmq-basic-auth
    namespace: monitoring
    data:
    - key: username
      remoteKey: /{{ .Environment.Name }}/prometheus/rabbitmq/username
    - key: password
      remoteKey: /{{ .Environment.Name }}/prometheus/rabbitmq/password
