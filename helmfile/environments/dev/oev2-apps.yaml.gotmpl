# vi: ft=yaml

environment: dev
namespace: dev
project: dev
appPrefix: oev2
tagRegex: ".*-dev"
appsDir: oddsengine

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: adapter-service
    config: adapter-service
    chart: platform-app
  - name: job-keepalive
    chart: platform-app
  - name: sportsbook-service-00
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-00.yaml
  - name: sportsbook-service-01
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-01.yaml
  - name: sportsbook-service-02
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-02.yaml
  - name: sportsbook-service-03
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-03.yaml
  - name: sportsbook-service-04
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-04.yaml
  - name: sportsbook-service-05
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-05.yaml
  - name: sportsbook-service-06
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-06.yaml
  - name: sportsbook-service-07
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-07.yaml
  - name: sportsbook-service-08
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-08.yaml
  - name: sportsbook-service-09
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-09.yaml
  - name: sportsbook-service-10
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - dev-10.yaml
  - name: job-settlement
    chart: platform-app
  - name: job-cleanup
    chart: platform-app
  - name: job-livestream
    chart: platform-app
  - name: job-lookup
    chart: platform-app
  - name: translation-service
    chart: platform-app
  - name: translation-job
    chart: platform-app
  - name: oev2-websocket-service
    config: websocket-service
    appImageOverride: oev2-websocket-service
    chart: platform-app

  - name: uof-client-g01
    config: uof-client
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-g01.yaml
