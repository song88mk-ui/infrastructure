# vi: ft=yaml

---
environments:
  stg:
    kubeContext: song88-stg-cluster
    values:
    - environments/stg/values.yaml
  prd:
    kubeContext: song88-prd-cluster
    values:
    - environments/prd/values.yaml
---
repositories:
- name: prometheus
  url: https://prometheus-community.github.io/helm-charts
- name: cluster-autoscaler
  url: https://kubernetes.github.io/autoscaler
- name: aws
  url: https://aws.github.io/eks-charts
- name: metrics-server
  url: https://kubernetes-sigs.github.io/metrics-server
- name: aws-ebs-csi-driver
  url: https://kubernetes-sigs.github.io/aws-ebs-csi-driver
- name: grafana
  url: https://grafana.github.io/helm-charts
- name: argo
  url: https://argoproj.github.io/argo-helm
- name: fluent
  url: https://fluent.github.io/helm-charts
- name: external-secrets
  url: https://charts.external-secrets.io
- name: external-dns
  url: https://kubernetes-sigs.github.io/external-dns/
- name: simcube
  url: https://simcubeltd.github.io/simcube-helm-charts/
- name: bitnami
  url: https://charts.bitnami.com/bitnami
- name: eks
  url: https://aws.github.io/eks-charts
- name: metabase
  url: https://pmint93.github.io/helm-charts
- name: opencost
  url: https://opencost.github.io/opencost-helm-chart

helmDefaults:
  verify: false
  wait: true
  waitForJobs: true
  timeout: 600
  recreatePods: false
  force: false
  historyMax: 10
  createNamespace: true

releases:
  # Before the chart is deployed for the first time we need to manually install the CRDS:
  # https://github.com/prometheus-community/helm-charts/blob/fe336479d023ffa08590a5958b044bfa4754c162/charts/kube-prometheus-stack/UPGRADE.md
  - name: prometheus-operator
    namespace: monitoring
    chart: prometheus/kube-prometheus-stack
    version: 83.7.0
    values:
      - common/prometheus-operator.yaml.gotmpl
      - common/prometheus-alert-templates.yaml
      - environments/{{ .Environment.Name }}/prometheus-operator.yaml.gotmpl
    needs:
      - kube-system/storage-class
      - kube-system/priority-class
      - kube-system/aws-load-balancer-controller

  # Needs the corresponding IAM role created by Terraform.
  - name: cluster-autoscaler
    namespace: kube-system
    chart: cluster-autoscaler/cluster-autoscaler
    version: 9.53.0
    values:
      - common/cluster-autoscaler.yaml.gotmpl

  - name: metrics-server
    namespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.13.0
    values: []

  - name: loki
    namespace: monitoring
    chart: grafana/loki
    version: 6.49.0
    values:
      - common/loki.yaml.gotmpl

  - name: tempo
    namespace: monitoring
    chart: grafana/tempo
    version: 1.24.1
    values:
      - common/tempo.yaml.gotmpl

  - name: external-dns-cloudflare
    namespace: kube-system
    chart: external-dns/external-dns
    version: 1.20.0
    values:
      - common/external-dns-cloudflare.yaml.gotmpl
    needs:
      - external-secrets/secret-stores

  - name: argocd
    namespace: argocd
    createNamespace: true
    chart: argo/argo-cd
    version: 9.5.11
    values:
      - common/argocd.yaml.gotmpl
      - common/argocd-notifications.yaml
      - environments/{{ .Environment.Name }}/argocd.yaml

  - name: argocd-image-updater
    namespace: argocd
    chart: argo/argocd-image-updater
    version: 0.14.0
    values:
      - common/argocd-image-updater.yaml.gotmpl

  - name: fluent-bit
    namespace: kube-system
    chart: fluent/fluent-bit
    version: 0.54.0
    values:
      - common/fluent-bit.yaml.gotmpl
    needs:
      - monitoring/loki

  # Needs the corresponding IAM role created by Terraform and manually installing the CRDs.
  - name: aws-load-balancer-controller
    namespace: kube-system
    chart: eks/aws-load-balancer-controller
    version: 3.1.0
    values:
      - common/aws-load-balancer-controller.yaml.gotmpl

  # Needs the corresponding IAM role created by Terraform.
  - name: external-secrets
    namespace: external-secrets
    chart: external-secrets/external-secrets
    version: 1.0.0
    values:
      - common/external-secrets.yaml

  - name: storage-class
    namespace: kube-system
    chart: charts/storage-class
    version: 1.0.0

  - name: priority-class
    namespace: kube-system
    chart: charts/priority-class
    version: 1.0.0

  - name: secret-stores
    namespace: external-secrets
    chart: charts/secret-stores
    version: 1.2.0
    values:
      - common/secret-stores.yaml.gotmpl
    needs:
      - external-secrets

  - name: blackbox-exporter
    namespace: monitoring
    chart: prometheus/prometheus-blackbox-exporter
    version: 11.5.0
    values:
      - common/blackbox-exporter.yaml.gotmpl
      - environments/{{ .Environment.Name }}/blackbox-exporter.yaml

  - name: argocd-projects
    namespace: argocd
    chart: charts/argocd-projects
    version: 1.0.0
    values:
      - common/argocd-projects.yaml.gotmpl
    needs:
      - argocd

  - name: bg-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/bg-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/bg-apps.yaml.gotmpl
    needs:
      - argocd

  - name: platform-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/platform-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/platform-apps.yaml.gotmpl
    needs:
      - argocd
      - argocd-projects

  - name: oddsfeed-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/oddsfeed-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/oddsfeed-apps.yaml.gotmpl
    needs:
      - argocd
      - argocd-projects

  - name: checklist-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/checklist-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/checklist-apps.yaml.gotmpl
    needs:
      - argocd
      - argocd-projects

  - name: backoffice-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/backoffice-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/backoffice-apps.yaml.gotmpl
    needs:
      - argocd
      - argocd-projects

  - name: corp-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/corp-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/corp-apps.yaml.gotmpl
    needs:
      - argocd
      - argocd-projects

  # odds-engine-2 applications
  - name: oev2-apps
    namespace: argocd
    chart: charts/argocd-apps
    version: 1.0.0
    values:
      - common/oev2-apps.yaml.gotmpl
      - environments/{{ .Environment.Name }}/oev2-apps.yaml.gotmpl
    needs:
      - argocd
      - argocd-projects

  - name: postgresql
    namespace: data
    chart: bitnami/postgresql
    version: 18.1.10
    values:
      - common/postgresql.yaml.gotmpl
      - environments/{{ .Environment.Name }}/postgresql.yaml.gotmpl

  - name: mssql
    namespace: bet-genius-apps
    chart: simcube/mssqlserver-2022
    version: 1.2.3
    values:
      - sapassword: YourStrong@Passw0rd123
      - acceptEula:
          value: "Y"
      - persistence:
          enabled: true
          storageClass: "gp3"
          dataSize: 10Gi
      - resources:
          requests:
            cpu: 10m
            memory: 2Gi # Minimum requirement
      - service:
          type: NodePort
          nodePort: 31433

  # NOTE: Rabbitmq is installed following: https://www.rabbitmq.com/kubernetes/operator/quickstart-operator
  # TODO: It should be moved to AWS when ready

  - name: db-proxy
    namespace: bet-genius-apps
    chart: charts/db-proxy
    version: 1.0.0
    values:
      - environments/{{ .Environment.Name }}/db-proxy.yaml.gotmpl

  - name: version-manifest
    namespace: platform
    chart: charts/version-manifest
    version: 1.0.0
    values:
      - common/version-manifest.yaml.gotmpl

  - name: metabase
    namespace: metabase
    chart: metabase/metabase
    version: 2.26.0
    values:
      - common/metabase.yaml.gotmpl
      - environments/{{ .Environment.Name }}/metabase.yaml.gotmpl

  - name: metabase-backup
    namespace: metabase
    installed: {{ eq .Environment.Name "prd" }}
    chart: charts/metabase-backup
    version: 1.0.0

  - name: translation-db-updater
    namespace: platform
    chart: charts/translation-db-updater
    version: 1.0.0
    values:
      - common/translation-db-updater.yaml.gotmpl

  - name: metabase-slack-messages
    namespace: platform
    chart: charts/metabase-slack-messages
    version: 1.0.0

  - name: opencost
    namespace: monitoring
    chart: opencost/opencost
    version: 2.5.26
    values:
      - common/opencost.yaml.gotmpl
      - environments/{{ .Environment.Name }}/opencost.yaml.gotmpl
