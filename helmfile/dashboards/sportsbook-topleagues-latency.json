    {
      "type": "timeseries",
      "title": "Mean time per phase (stacked)",
      "description": "Mean, not percentile: the default buckets start at 5 ms, so sub-5 ms phases have no percentile resolution.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (phase) (rate({__name__=~\"sportsbook_topleagues_phase_duration(_milliseconds)?_sum\", phase!=\"total\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__rate_interval])) / sum by (phase) (rate({__name__=~\"sportsbook_topleagues_phase_duration(_milliseconds)?_count\", phase!=\"total\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__rate_interval]))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
