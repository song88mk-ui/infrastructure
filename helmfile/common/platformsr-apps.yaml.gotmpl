# vi: ft=yaml

environment: {{ .Environment.Name }}
namespace: platformsr
project: platform-sr
appPrefix: platform

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: betinfo-service
    chart: platform-app
  - name: cancellation-service
    chart: platform-app
  - name: client-api
    chart: platform-app
  - name: client-topmarket-service
    chart: platform-app
  - name: clientplatform-api
    chart: platform-app
  - name: clientsportsbook-api
    chart: platform-app
  - name: job-forexeur
    chart: platform-app
  - name: job-resettlement
    chart: platform-app
  - name: operator-cashout-service
    chart: platform-app
