        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum(increase({__name__=~\"sportsbook_topleagues_requests(_count)?(_total)?\", cache=\"miss\", concurrent_miss=\"true\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__range])) or vector(0)) / sum(increase({__name__=~\"sportsbook_topleagues_requests(_count)?(_total)?\", cache=\"miss\", namespace=~\"$namespace\", sport_id=~\"$sport_id\", language=~\"$language\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
