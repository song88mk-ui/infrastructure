# vi: ft=yaml

environment: {{ .Environment.Name }}
namespace: oddsfeed
project: oddsfeed
appPrefix: of
appsDir: oddsfeed

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: rabbitmq-api
    chart: platform-app
  - name: sportsbook-api
    chart: platform-app
  - name: betting-api
    chart: platform-app
  - name: client-api
    chart: platform-app
  - name: platformclient-api
    chart: platform-app
  - name: placement-service
    chart: platform-app
  - name: cancellation-retry
    chart: platform-app
  - name: cancellation-service
    chart: platform-app
  - name: job-resettlement
    chart: platform-app
  - name: operator-service
    chart: platform-app
  - name: settlement-service
    chart: platform-app
  - name: recovery-service
    chart: platform-app



