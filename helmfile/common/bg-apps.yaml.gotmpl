environment: {{ .Environment.Name }}
namespace: bet-genius-apps
project: default

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

# NOTE: The config of the bet-genius app contains a lot of overrides
# because it was created with a different schema.
# TODO: We'll need to re-create the apps and remove the overrides.
apps:
  - name: bet-genius-apps-bg-engine-sportsbook
    chart: betgenius-app
    appImageOverride: bg-engine-sportsbook
    valueFilesOverride:
    - ../../apps/bg-engine-sportsbook/{{ .Environment.Name }}.yaml
    - ../../argocd-image-updater/bg-engine-sportsbook/{{ .Environment.Name }}.yaml
  - name: bet-genius-apps-bg-feed-receiver-api
    chart: betgenius-app
    appImageOverride: bg-feed-receiver-api
    valueFilesOverride:
    - ../../apps/bg-feed-receiver-api/{{ .Environment.Name }}.yaml
    - ../../argocd-image-updater/bg-feed-receiver-api/{{ .Environment.Name }}.yaml
  - name: bet-genius-apps-bg-rabbitmq-api
    chart: betgenius-app
    appImageOverride: bg-rabbitmq-api
    valueFilesOverride:
    - ../../apps/bg-rabbitmq-api/{{ .Environment.Name }}.yaml
    - ../../argocd-image-updater/bg-rabbitmq-api/{{ .Environment.Name }}.yaml
  - name: bet-genius-apps-bg-receiver-service
    chart: betgenius-app
    appImageOverride: bg-receiver-service
    valueFilesOverride:
    - ../../apps/bg-receiver-service/{{ .Environment.Name }}.yaml
    - ../../argocd-image-updater/bg-receiver-service/{{ .Environment.Name }}.yaml
  - name: bet-genius-apps-bg-feedlogger-service
    chart: betgenius-app
    appImageOverride: bg-feedlogger-service
    valueFilesOverride:
    - ../../apps/bg-feedlogger-service/{{ .Environment.Name }}.yaml
    - ../../argocd-image-updater/bg-feedlogger-service/{{ .Environment.Name }}.yaml
  - name: bet-genius-apps-bg-heartbeat-listener
    chart: betgenius-app
    appImageOverride: bg-heartbeat-listener
    valueFilesOverride:
    - ../../apps/bg-heartbeat-listener/{{ .Environment.Name }}.yaml
    - ../../argocd-image-updater/bg-heartbeat-listener/{{ .Environment.Name }}.yaml
