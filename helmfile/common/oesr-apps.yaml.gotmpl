# vi: ft=yaml
#
# repo: oddsengine
# SR based OddsEngine
#
environment: {{ .Environment.Name }}
namespace: oesr
project: oddsengine-sr
appPrefix: oe

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: rabbitmq-api
    chart: oesr-app
  - name: adapter-uof
    chart: oesr-app
  - name: adapter-service
    chart: oesr-app
  # sportsbook
  - name: sportsbook-service-00
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-00.yaml
  - name: sportsbook-service-01
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-01.yaml
  - name: sportsbook-service-02
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-02.yaml
  - name: sportsbook-service-03
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-03.yaml
  - name: sportsbook-service-04
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-04.yaml
  - name: sportsbook-service-05
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-05.yaml
  - name: sportsbook-service-06
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-06.yaml
  - name: sportsbook-service-07
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-07.yaml
  - name: sportsbook-service-08
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-08.yaml
  - name: sportsbook-service-09
    config: sportsbook-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-09.yaml
  ## engine v2
  - name: engine-service-00
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-00.yaml
  - name: engine-service-01
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-01.yaml
  - name: engine-service-02
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-02.yaml
  - name: engine-service-03
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-03.yaml
  - name: engine-service-04
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-04.yaml
  - name: engine-service-05
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-05.yaml
  - name: engine-service-06
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-06.yaml
  - name: engine-service-07
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-07.yaml
  - name: engine-service-08
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-08.yaml
  - name: engine-service-09
    config: engine-service
    chart: oesr-app
    valueFiles:
      - {{ .Environment.Name }}-09.yaml
  # others
  - name: mapping-service
    chart: oesr-app
  - name: adapter-translation-service
    chart: oesr-app
  - name: fastodds-api
    chart: oesr-app
  - name: api
    config: oe-api
    chart: oesr-app
