# vi: ft=yaml
#
# repo: odds-engine-2
# Bet Genius based OddsEngine
#
environment: {{ .Environment.Name }}
namespace: oddsengine
project: oddsengine
appPrefix: oev2

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: adapter-service
    config: adapter-service
    chart: platform-app
  - name: uof-client-tso
    config: uof-client
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-tso.yaml
  - name: websocket-service-tso
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-tso.yaml
  - name: sportsbook-service-00
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-00.yaml
  - name: sportsbook-service-01
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-01.yaml
  - name: sportsbook-service-02
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-02.yaml
  - name: sportsbook-service-03
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-03.yaml
  - name: sportsbook-service-04
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-04.yaml
  - name: sportsbook-service-05
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-05.yaml
  - name: sportsbook-service-06
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-06.yaml
  - name: sportsbook-service-07
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-07.yaml
  - name: sportsbook-service-08
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-08.yaml
  - name: sportsbook-service-09
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-09.yaml
  - name: sportsbook-service-10
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-10.yaml
