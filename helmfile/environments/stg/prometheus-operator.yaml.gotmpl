prometheus:
  # We don't care about redundancy on a non-prod environment.
  podDisruptionBudget:
    enabled: false
    minAvailable: 1

  prometheusSpec:
    replicas: 1
    scrapeInterval: 30s
    additionalScrapeConfigs:
      - job_name: "node-exporter-mongodb"
        scrape_interval: 5s
        scheme: http
        static_configs:
          - targets: ['10.49.100.55:9092']
      - job_name: "mongodb-exporter"
        scrape_interval: 5s
        scheme: http
        static_configs:
          - targets: ['10.49.100.55:9216']

grafana:
  grafana.ini:
    auth.google:
      name: Google
      enabled: true
      allow_sign_up: true
      auto_login: false
      client_id: "ref+awsssm://stg/song88/google/client-id?region=ap-south-1"
      client_secret: "ref+awsssm://stg/song88/google/client-secret?region=ap-south-1"
      scopes: openid email profile
      role_attribute_path: contains('["ksideris@song88.com","erivera@song88.com","michel@song88.com"]', email) && 'Admin' || 'Editor'
      role_attribute_strict: true
      skip_org_role_sync: true
      allowed_domains: song88.com
      hosted_domain: song88.com

alertmanager:
  # We don't care about redundancy on a non-prod environment.
  podDisruptionBudget:
    enabled: false
    minAvailable: 1
  alertmanagerSpec:
    replicas: 1
