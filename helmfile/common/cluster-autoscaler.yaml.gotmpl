autoDiscovery:
  clusterName: {{ .Values.clusterName }}

replicaCount: 2

podDisruptionBudget:
  maxUnavailable: 1

resources:
  requests:
    cpu: 10m
    memory: 80Mi

rbac:
  create: true
  serviceAccount:
    create: true
    name: cluster-autoscaler-sa

awsRegion: {{ .Values.awsRegion }}

customArgs:
  - "--balance-similar-node-groups=true"
