# vi: ft=yaml

environment: {{ .Environment.Name }}
namespace: oddsengine
project: default

accountID: "{{ .Values.accountID }}"
awsRegion: "{{ .Values.awsRegion }}"

apps:
  - name: oe-adapter-service
    image: oev2-adapter-service
    config: oev2-adapter-service
    chart: platform-app
  - name: oe-sportsbook-service-00
    image: oev2-sportsbook-service
    config: oev2-sportsbook-service
    chart: platform-app
    valueFiles:
      - ../../apps/oev2-sportsbook-service/{{ .Environment.Name }}-00.yaml
  - name: oe-sportsbook-service-01
    image: oev2-sportsbook-service
    config: oev2-sportsbook-service
