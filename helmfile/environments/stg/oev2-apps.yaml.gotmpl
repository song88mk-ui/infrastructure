# vi: ft=yaml
---
tagRegex: ".*-stg"

apps:
  - name: adapter-service
    config: adapter-service
    chart: platform-app
  - name: job-keepalive
    chart: platform-app
  - name: sportsbook-service-00
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-00.yaml
  - name: sportsbook-service-01
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-01.yaml
  - name: sportsbook-service-02
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-02.yaml
  - name: sportsbook-service-03
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-03.yaml
  - name: sportsbook-service-04
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-04.yaml
  - name: sportsbook-service-05
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-05.yaml
  - name: sportsbook-service-06
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-06.yaml
  - name: sportsbook-service-07
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-07.yaml
  - name: sportsbook-service-08
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-08.yaml
  - name: sportsbook-service-09
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-09.yaml
  - name: sportsbook-service-10
    config: sportsbook-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-10.yaml
  - name: job-settlement
    chart: platform-app
  - name: job-cleanup
    chart: platform-app
  - name: job-livestream
    chart: platform-app
  - name: job-lookup
    chart: platform-app

  # apps for stg only
  - name: uof-client-g02
    config: uof-client
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-g02.yaml

  - name: websocket-service-g02
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-g02.yaml
  - name: websocket-service-qte
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-qte.yaml
  - name: websocket-service-krj
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-krj.yaml
  - name: websocket-service-gsa
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-gsa.yaml
  - name: websocket-service-oge
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ .Environment.Name }}-oge.yaml

{{- range $brand := .Values.AdeytechBrands }}
  - name: websocket-service-{{ $brand.name | lower }}
    config: websocket-service
    chart: platform-app
    valueFiles:
      - {{ $.Environment.Name }}-{{ $brand.name | lower }}.yaml
    rawValuesContents:
      fullnameOverride: websocket-service-{{ $brand.name | lower }}

      secrets:
        - name: websocket-service-{{ $brand.name | lower }}
          data:
          - key: rabbitmq-username
            remoteKey: /{{ $.Environment.Name }}/apps/rabbitmq/username
            envVariable: MessageBroker__Username
          - key: rabbitmq-password
            remoteKey: /{{ $.Environment.Name }}/apps/rabbitmq/password
            envVariable: MessageBroker__Password

      env:
        MessageBroker__Queue: "q.sb.engine.websocket.{{ $brand.name }}"
        MessageBroker__Consumer: "OE.Engine.WebSocket.{{ $brand.name }}"
        MessageBroker__RoutingKey: "r.oe.sb.engine.onoddschange|r.oe.sb.engine.onbetstopfixture|r.oe.sb.engine.onbetstopglobal|r.bet.betstatus.{{ $brand.name | lower }}|r.bet.cashoutchange.{{ $brand.name | lower }}|r.wallet.{{ $brand.name | lower }}|r.oe.sb.engine.onvisitfavorites.{{ $brand.name | lower }}|r.oe.sb.engine.onvisitboostedfixtures.{{ $brand.name | lower }}|r.oe.sb.engine.onmarketsortorderchange.{{ $brand.name | lower }}"
        Custom__ClientId: "{{ $brand.client_id }}"
        Custom__ClientCode: "{{ $brand.name }}"
{{- end }}
